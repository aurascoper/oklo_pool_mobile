    "correction_2_reaction_kinetics_models": {
      "rejected_saturated_boltzmann_formula": "min(1.0, exp(-(Delta_G_dagger - F * Delta_x_dagger) / (k_B * T)))",
      "rejection_reason": "Clamps to 100% bond synthesis probability for all forces F >= Delta_G_dagger / Delta_x_dagger = 0.625 nN, conflating a thermodynamic barrier shift with a finite-time reaction probability and omitting competing hydrolysis.",
      "approved_candidate_topologies": [
        {
          "topology_id": "competing_precursor_hazards",
          "reaction_scheme": "M* -> P_bond (rate k_syn) vs M* -> M_inact (rate k_deact) from the same activated precursor",
          "synthesis_probability_equation": "P_syn(dt) = (k_syn / (k_syn + k_deact)) * (1.0 - exp(-(k_syn + k_deact) * dt))",
          "rate_units": "s^-1",
          "time_units": "s",
          "evidence_classification": "uncalibrated_candidate_kinetic_law"
        },
        {
          "topology_id": "sequential_product_hydrolysis",
          "reaction_scheme": "M -> P_chain (rate k_syn) -> D_deg (rate k_hyd) where hydrolysis destroys already-synthesized product",
          "intact_product_equation": "f_product(dt) = k_syn * (exp(-k_syn * dt) - exp(-k_hyd * dt)) / (k_hyd - k_syn)",
          "precursor_equation": "f_precursor(dt) = exp(-k_syn * dt)",
          "degraded_equation": "f_degraded(dt) = 1.0 - f_precursor(dt) - f_product(dt)",
          "rate_units": "s^-1",
          "time_units": "s",
          "evidence_classification": "uncalibrated_candidate_kinetic_law"
        }
      ],
      "bell_evans_force_modulation": {
        "equation": "k_syn(F, T) = k_0(T) * exp(dot(F, Delta_x_dagger) / (k_B * T))",
        "requires_vector_projection_onto_reaction_coordinate": true,
        "evidence_classification": "uncalibrated_candidate_kinetic_law"
      }
    },
